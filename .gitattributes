# Enforce consistent LF line endings so shell/Python/YAML files never break when edited on Windows
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.env  text eol=lf
*.mmd  text eol=lf
*.ps1  text eol=lf

# Binary assets
*.deb    binary
*.tar    binary
*.tar.gz binary
*.tgz    binary
*.png    binary
*.jpg    binary
*.pdf    binary

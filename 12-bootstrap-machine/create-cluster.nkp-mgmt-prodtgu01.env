# Copy to create-cluster.env. This is the nkp create cluster path, not the Helm chart.
# Fill REGISTRY_MIRROR_* from registry/credentials.env after setup-local-registry.sh.
CLUSTER_NAME=nkp-mgmt-prodtgu01
CLUSTER_HOSTNAME=nkp-mgmt-prodtgu01.bancodeoccidente.lan

NUTANIX_USER=nkp_admin_user
NUTANIX_PASSWORD=CHANGE-ME
NUTANIX_ENDPOINT=192.168.170.15
NUTANIX_PORT=9440
NUTANIX_PRISM_ELEMENT_CLUSTER_NAME=NKP_PRISMELTGU
NUTANIX_SUBNET_NAME=VLAN 4031
NUTANIX_STORAGE_CONTAINER_NAME=CHANGE-ME
NUTANIX_MACHINE_TEMPLATE_IMAGE_NAME=NKP_UBUNTU_PRO_2404

CONTROL_PLANE_ENDPOINT_IP=172.16.112.10
LB_IP_RANGE=172.16.112.11-172.16.112.20
PODS_CIDR=100.112.0.0/16
SERVICES_CIDR=100.113.0.0/16

CONTROL_PLANE_REPLICAS=3
CONTROL_PLANE_VCPUS=4
CONTROL_PLANE_MEMORY=16
CONTROL_PLANE_DISKSIZE=80
WORKER_REPLICAS=3
WORKER_VCPUS=8
WORKER_MEMORY=32
WORKER_DISKSIZE=100

SSH_USERNAME=konvoy
SSH_PUBKEY=/home/ubuntu/.ssh/id_ed25519.pub
NTP_SERVERS=10.4.101.18

DRY_RUN=true
BOOTSTRAP_CLUSTER_IMAGE_PATH=

REGISTRY_MIRROR_URL=https://CHANGE-ME:5000
REGISTRY_MIRROR_USERNAME=nkp
REGISTRY_MIRROR_PASSWORD=CHANGE-ME
REGISTRY_MIRROR_CACERT=/home/ubuntu/nkp-workspace/registry/certs/ca.crt

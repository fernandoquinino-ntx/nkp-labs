# Copy to create-cluster.env and edit. scripts/create-cluster.sh reads this file.
# Do not commit create-cluster.env (it holds the Prism password).
# Flag names match nkp-deployer .../traditional/nkp-installer.sh.

CLUSTER_NAME=nkp-mgmt
CLUSTER_HOSTNAME=nkp-mgmt.ntnxlab.local

NUTANIX_USER=admin
NUTANIX_PASSWORD=CHANGE-ME
NUTANIX_ENDPOINT=10.0.0.1
NUTANIX_PORT=9440
NUTANIX_PRISM_ELEMENT_CLUSTER_NAME=PRISM-ELEMENT-CLUSTER-NAME
NUTANIX_SUBNET_NAME=data-subnet
NUTANIX_STORAGE_CONTAINER_NAME=SelfServiceContainer
NUTANIX_MACHINE_TEMPLATE_IMAGE_NAME=nkp-rocky-9.8-1.36.2

CONTROL_PLANE_ENDPOINT_IP=10.0.0.12
LB_IP_RANGE=10.0.0.13-10.0.0.18
PODS_CIDR=10.95.0.0/16
SERVICES_CIDR=10.96.0.0/12

CONTROL_PLANE_REPLICAS=3
CONTROL_PLANE_VCPUS=4
CONTROL_PLANE_MEMORY=16
CONTROL_PLANE_DISKSIZE=80
WORKER_REPLICAS=2
WORKER_VCPUS=8
WORKER_MEMORY=32
WORKER_DISKSIZE=80

SSH_USERNAME=konvoy
SSH_PUBKEY=/home/ubuntu/.ssh/id_ed25519.pub
NTP_SERVERS=pool.ntp.org,time.google.com

# true prints the NKPCluster YAML and does not create VMs
DRY_RUN=false
# optional image tarball for an air-gapped kind bootstrap
BOOTSTRAP_CLUSTER_IMAGE_PATH=

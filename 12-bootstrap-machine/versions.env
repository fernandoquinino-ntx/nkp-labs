# Single source of truth for Lab 12 release version and bootstrap toolchain versions.
# Sourced by scripts/bootstrap-host.sh when present and verified by CI against
# Helm charts, cloud-init templates, workflows, standalone scripts, and docs.
#
# Backward-compatibility guarantee: auto-update supports up to 3 previous versions
# (same MAJOR, 0 <= target_minor - installed_minor <= LAB_COMPAT_WINDOW).
LAB_VERSION="1.3.0"
LAB_COMPAT_WINDOW="3"
LAB_MIN_COMPAT_VERSION="1.0.0"


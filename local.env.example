# local.env.example — copy to `local.env` (gitignored) and set YOUR values.
# The lab manifests use these ${PLACEHOLDERS}; scripts/render.sh substitutes them.

NAMESPACE=labs

# A ReadWriteMany StorageClass (labs 01/02 need RWX).
#   Nutanix NUS ...... nus-files (or a per-SC files-key one)
#   CephFS .......... cephfs
#   NFS ............. nfs-client
RWX_STORAGE_CLASS=<your-rwx-storageclass>

PVC_SIZE=1Gi

# Ingress lab (04): the app is served at "${APP_HOST}.${DOMAIN}".
#   NKP example (managed cluster): DOMAIN=apps.ds-cluster01.ntnxlab.local  APP_HOST=apache
DOMAIN=example.com
APP_HOST=apache

# The cluster ingress class.
#   NKP ....... kommander-traefik
#   nginx ..... nginx
INGRESS_CLASS=<your-ingress-class>

# How many apache replicas to run (lab 02).
REPLICAS=3

# ServiceAccount name for lab 06 (long-lived token kubeconfig).
SA_NAME=lab-app

# Namespace where Velero runs (lab 07). NKP: `kommander` (mgmt) or the workspace ns.
VELERO_NS=kommander

# Optional: the DNS server to use with scripts/dns-add.sh (dynamic BIND / nsupdate).
# DNS_SERVER=10.0.0.53
# DNS_ZONE=ntnxlab.local

# ---------------------------------------------------------------------------
# Lab 08 — Splunk OpenTelemetry Collector via Helm (no NKP catalog)
# ---------------------------------------------------------------------------
# Where the collector runs.
OTEL_NAMESPACE=splunk-otel
OTEL_RELEASE=splunk-otel-collector
CHART_VERSION=0.160.0

# Shows up in Splunk as k8s.cluster.name — make it UNIQUE per cluster.
SPLUNK_CLUSTER_NAME=<your-cluster-name>

# Splunk Cloud HEC. The :8088 "/services/collector/event" path matters.
#   trial: https://prd-p-<id>.splunkcloud.com:8088/services/collector/event
SPLUNK_HEC_ENDPOINT=https://<your-stack>.splunkcloud.com:8088/services/collector/event

# SECRET — keep only in this gitignored local.env, never in a committed file.
# The HEC token must ALLOW both indexes below (Splunk UI:
# Settings > Data inputs > HTTP Event Collector > token > Selected Allowed Indexes).
SPLUNK_HEC_TOKEN=<your-hec-token>
SPLUNK_INDEX=k8s_logs
SPLUNK_METRICS_INDEX=k8s_metrics

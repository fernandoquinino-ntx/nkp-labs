# local.env.example — copy to `local.env` (gitignored) and set YOUR values.
# The lab manifests use these ${PLACEHOLDERS}; scripts/render.sh substitutes them.

NAMESPACE=labs

# A ReadWriteMany StorageClass (labs 01/02 need RWX).
#   Nutanix NUS ...... nus-files (or a per-SC files-key one)
#   CephFS .......... cephfs
#   NFS ............. nfs-client
RWX_STORAGE_CLASS=<your-rwx-storageclass>

PVC_SIZE=1Gi

# Ingress lab (04): the app is served at "${APP_HOST}.${DOMAIN}".
#   NKP example (managed cluster): DOMAIN=apps.ds-cluster01.ntnxlab.local  APP_HOST=apache
DOMAIN=example.com
APP_HOST=apache

# The cluster ingress class.
#   NKP ....... kommander-traefik
#   nginx ..... nginx
INGRESS_CLASS=<your-ingress-class>

# How many apache replicas to run (lab 02).
REPLICAS=3

# ServiceAccount name for lab 06 (long-lived token kubeconfig).
SA_NAME=lab-app

# Namespace where Velero runs (lab 07). NKP: `kommander` (mgmt) or the workspace ns.
VELERO_NS=kommander

# Optional: the DNS server to use with scripts/dns-add.sh (dynamic BIND / nsupdate).
# DNS_SERVER=10.0.0.53
# DNS_ZONE=ntnxlab.local

# ---------------------------------------------------------------------------
# Lab 08 — Splunk OpenTelemetry Collector via Helm (no NKP catalog)
# ---------------------------------------------------------------------------
# Where the collector runs.
OTEL_NAMESPACE=splunk-otel
OTEL_RELEASE=splunk-otel-collector
CHART_VERSION=0.160.0

# Shows up in Splunk as k8s.cluster.name — make it UNIQUE per cluster.
SPLUNK_CLUSTER_NAME=<your-cluster-name>

# Splunk Cloud HEC. The :8088 "/services/collector/event" path matters.
#   trial: https://prd-p-<id>.splunkcloud.com:8088/services/collector/event
SPLUNK_HEC_ENDPOINT=https://<your-stack>.splunkcloud.com:8088/services/collector/event

# SECRET — keep only in this gitignored local.env, never in a committed file.
# The HEC token must ALLOW both indexes below (Splunk UI:
# Settings > Data inputs > HTTP Event Collector > token > Selected Allowed Indexes).
SPLUNK_HEC_TOKEN=<your-hec-token>
SPLUNK_INDEX=k8s_logs
SPLUNK_METRICS_INDEX=k8s_metrics

# ---------------------------------------------------------------------------
# Lab 09 — protect an app with Okta OIDC (Traefik OIDC plugin middleware)
# ---------------------------------------------------------------------------
# The app is served at "${OIDC_HOST}.${DOMAIN}" (DOMAIN comes from the ingress lab above).
OIDC_HOST=whoami

# Version of the `traefikoidc` Traefik plugin (traefik-plugin/overrides.example.yaml).
# Pick one compatible with your Traefik release: https://plugins.traefik.io
OIDC_PLUGIN_VERSION=v1.0.36

# Namespace where Traefik runs (its AppDeployment + the plugin override live here).
#   NKP (management) ..... kommander
#   plain Helm ........... traefik
TRAEFIK_NS=kommander

# Okta OIDC. Issuer = https://<org>.okta.com (Org AS) or
# https://<org>.okta.com/oauth2/<authServerId> (custom AS). It MUST match the token `iss`.
OKTA_ISSUER=https://<your-org>.okta.com
OKTA_CLIENT_ID=<okta-client-id>

# SECRET — keep only in this gitignored local.env, never in a committed file.
OKTA_CLIENT_SECRET=<okta-client-secret>

# SECRET — cookie encryption key, at least 32 bytes. Generate:  openssl rand -base64 32
OIDC_SESSION_KEY=<32-byte-random-string>

# Authorization: email domain(s) allowed, and (optional) Okta group(s).
# Group authz also needs a `groups` claim + `scopes: [groups]` in oidc/middleware.yaml.
OIDC_ALLOWED_DOMAINS=example.com
OIDC_ALLOWED_GROUPS=My-App-Users

# ---------------------------------------------------------------------------
# Lab 10 — Vault + External Secrets Operator (ESO) via AppDeployment override
# ---------------------------------------------------------------------------
# The workload cluster to deploy to, and that cluster's WORKSPACE namespace on the management
# cluster (which holds the AppDeployment + the override ConfigMap).
WORKLOAD_CLUSTER=ds-cluster01
WORKSPACE_NS=datascience-xmfnz

# The ESO platform app (NKP catalog). List on the mgmt cluster:  kubectl get clusterapp | grep external-secrets
ESO_APP_ID=external-secrets
ESO_APP_VERSION=2.3.0
ESO_CLUSTERAPP=external-secrets-2.3.0
# The AppDeployment override ConfigMap (the UI-visible field).
ESO_OVERRIDES_CM=external-secrets-overrides
# Where ESO runs on the workload cluster, and the ServiceAccount it presents to Vault.
ESO_NAMESPACE=external-secrets
ESO_SA=eso-vault

# The objects this lab creates.
SECRETSTORE_NAME=vault-backend
EXTERNAL_SECRET_NAME=lab-app-credentials

# Vault (on the management cluster), reachable FROM the workload cluster over its ingress.
VAULT_SERVER=https://vault.nkp.ntnxlab.local
# base64 PEM of the CA that signed Vault's server cert. Fill with:  ./10-vault-eso/scripts/fetch-vault-ca.sh
VAULT_CA_BUNDLE=
# The Vault kubernetes auth mount bound to THIS workload cluster (see vault/remote-auth.md),
# the role, and the policy the role uses.
VAULT_AUTH_MOUNT=kubernetes-ds-cluster01
VAULT_ROLE=eso
VAULT_POLICY=eso-ds-cluster01
# KV v2: engine mount + item path (remoteRef.key is RELATIVE to the mount — do not repeat "secret/").
VAULT_KV_MOUNT=secret
VAULT_SECRET_PATH=app-credentials

# The demo secret to seed in Vault (Lab 10 step 03) — SECRET.
VAULT_USERNAME=admin
VAULT_PASSWORD=<change-me>

# Demo consumer image (needs sh + sleep).
DEMO_IMAGE=busybox:1.36

# --- Optional: kubeconfigs so the lab scripts hit the right cluster ---------------------------
# When unset, the scripts use your current kubectl context. On jump-01:
# MGMT_KUBECONFIG=~/dc1-nkp-cl01.conf
# WORKLOAD_KUBECONFIG=~/ds-cluster01.conf

# Copy to env and edit. install-nkp.sh reads this file.
# Do not commit env or values.local.yaml.

CLUSTER_NAME=nkp-mgmt
NAMESPACE=kommander
# control-plane replicas + worker replicas (chart defaults: 3 + 2)
EXPECTED=5
BOOTSTRAP_TIMEOUT=20m
INSTALL_KOMMANDER=false
INSTALL_TIMEOUT=1h
# set true to stop after the management kubeconfig, before the self-managed pivot
SKIP_PIVOT=false
